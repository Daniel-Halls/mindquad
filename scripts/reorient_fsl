#!/usr/bin/env python3
"""Executable wrapper for mindquad reorient_fsl script."""

import sys
from pathlib import Path

# Add project root to sys.path so mindquad can be imported
PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from mindquad.workflow.scripts.reorient_fsl import main  # noqa: E402

if __name__ == "__main__":
    main()
