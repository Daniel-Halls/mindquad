"""Mindquad Snakemake workflow entry point."""

import os

default_config = os.path.join(workflow.basedir, "../config/config.yaml")
if os.path.exists(default_config):
    configfile: default_config

include: "rules/common.smk"
include: "rules/bids_setup.smk"
include: "rules/mriqc.smk"
include: "rules/fastsurfer.smk"
include: "rules/fmriprep.smk"
include: "rules/qsiprep.smk"
include: "rules/coregistration.smk"
include: "rules/hcp_postfreesurfer.smk"
include: "rules/mrs.smk"



def get_dynamic_targets(wildcards):
    targets = [
        f"{get_bids_dir()}/dataset_description.json",
    ]
    
    for subject in get_bids_subjects():
        # Evaluate checkpoint: forces Snakemake to wait for organize_bids_subject to finish
        checkpoints.organize_bids_subject.get(subject=subject)
        
        bids_dir = Path(get_bids_dir()) / f"sub-{subject}"
        
        has_anat = (bids_dir / "anat").exists()
        has_func = (bids_dir / "func").exists()
        has_dwi = (bids_dir / "dwi").exists()
        has_mrs = (bids_dir / "mrs").exists()
        
        has_t2w = False
        has_flair = False
        if has_anat:
            anat_files = [f.name.lower() for f in (bids_dir / "anat").iterdir() if f.is_file()]
            has_t2w = any("t2w" in f for f in anat_files)
            has_flair = any("flair" in f for f in anat_files)

        # Only append the terminal leaf nodes for this subject
        
        # If they have functional data, fMRIPrep is the leaf.
        if has_func and has_anat:
            targets.append(f"{get_fmriprep_dir()}/sub-{subject}/.fmriprep_complete")
            targets.append(f"{get_fmriprep_dir()}/sub-{subject}.html")
            
        # If they have DWI data, QSIPrep is the leaf.
        if has_dwi and has_anat:
            targets.append(f"{get_qsiprep_dir()}/sub-{subject}/.qsiprep_complete")
            targets.append(f"{get_qsiprep_dir()}/sub-{subject}.html")
            
        # If they have T2w or FLAIR data, HCP is the leaf.
        if has_t2w or has_flair:
            targets.append(f"{get_hcp_dir()}/sub-{subject}/.hcp_complete")
            targets.append(f"{get_hcp_dir()}/sub-{subject}/MNINonLinear/fsaverage_LR32k/sub-{subject}.32k_fs_LR.wb.spec")
            
        # If they have MRS data, MRS is the leaf.
        if has_mrs and has_anat:
            targets.append(f"{get_mrs_dir()}/sub-{subject}/.mrs_complete")
            targets.append(f"{get_mrs_dir()}/sub-{subject}.html")
            targets.append(f"{get_mrs_dir()}/sub-{subject}/quantities.csv")

        # If they ONLY have T1w and no other modalities, FastSurfer is the leaf.
        if has_anat and not (has_func or has_dwi or has_t2w or has_flair or has_mrs):
            targets.append(f"{get_fastsurfer_dir()}/sub-{subject}/.fastsurfer_complete")
            targets.append(f"{get_fastsurfer_dir()}/sub-{subject}/mri/aparc.DKTatlas+aseg.deep.mgz")
            
    return targets


rule all:
    """Target rule that dynamically determines required targets based on BIDS contents."""
    input:
        get_dynamic_targets
